# Copy this file to `.env.local`. Never commit real keys.
# The Watch UI, NASA GIBS overlays, Open-Meteo, and RSS feeds run with all of
# these left empty. Fill in only what you need on your own machine.

# Optional — Claude analysis, morning brief, Think / Communicate / Reflect,
# Challenge, Arena, and Simulate.
ANTHROPIC_API_KEY=

# Optional — override the default Claude model name.
# ANTHROPIC_MODEL=claude-opus-4-20250514

# Optional — meeting transcription / web search helpers.
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_SEARCH_MODEL=gpt-5-mini

# Optional — production auth. Local dev has a built-in fallback.
# Set a long random value before deploying.
# JWT_SECRET=

# Optional — hosted LibSQL / Turso. Default is local file:db/non69.db
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
